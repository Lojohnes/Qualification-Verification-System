# AQVP Local Development Environment
# Copy this file to .env and update values for your local environment.
# Never commit .env files or real secrets.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5433/aqvp_db
DATABASE_USERNAME=aqvp
DATABASE_PASSWORD=aqvp
DATABASE_NAME=aqvp_db
DATABASE_PORT=5433

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST=localhost
KAFKA_PORT=9092

# ---------------------------------------------------------------------------
# JWT (Identity service)
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Per-service overrides (optional)
# If not set, each service falls back to DATABASE_URL/USERNAME/PASSWORD above.
# ---------------------------------------------------------------------------
# IDENTITY_DB_URL=jdbc:postgresql://localhost:5433/aqvp_db
# IDENTITY_DB_USERNAME=aqvp
# IDENTITY_DB_PASSWORD=aqvp
# ADMIN_DB_URL=jdbc:postgresql://localhost:5433/aqvp_db
# ADMIN_DB_USERNAME=aqvp
# ADMIN_DB_PASSWORD=aqvp
# QUALIFICATION_DB_URL=jdbc:postgresql://localhost:5433/aqvp_db
# QUALIFICATION_DB_USERNAME=aqvp
# QUALIFICATION_DB_PASSWORD=aqvp
# VERIFICATION_DB_URL=jdbc:postgresql://localhost:5433/aqvp_db
# VERIFICATION_DB_USERNAME=aqvp
# VERIFICATION_DB_PASSWORD=aqvp
