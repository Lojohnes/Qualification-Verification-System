# AQVP Frontend Environment Variables
# Copy this file to .env and update the value for your local environment.
# Never commit .env files or real secrets.

# Base URL for the AQVP Identity service
VITE_API_BASE_URL=http://localhost:8081

# Base URL for the AQVP Qualification service (Institutions, Programs)
VITE_QUALIFICATION_API_BASE_URL=http://localhost:8082

# Base URL for the AQVP Admin service (Audit, Notifications)
VITE_ADMIN_API_BASE_URL=http://localhost:8084
